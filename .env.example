# Face baking API key (Gemini preferred). Copy to .env — never commit .env.
# Uses gemini-2.5-flash-image (with fallbacks) and green-screen + chroma key for transparency.
GEMINI_API_KEY=your-gemini-api-key

# Optional fallback (OpenAI gpt-image-1.5 with native transparent PNG).
# OPENAI_API_KEY=sk-...

# Supabase — death screen score saves (publishable anon key only, never service_role).
# Create table: run supabase/migrations/20260812100000_run_scores.sql in SQL Editor.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
